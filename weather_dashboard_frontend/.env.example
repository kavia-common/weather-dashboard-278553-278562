# Environment variables for Weather Dashboard (React - Create React App)
# NOTE:
# - Variables MUST be prefixed with REACT_APP_ to be exposed to the client (CRA requirement).
# - After editing .env, you MUST restart `npm start` so changes take effect.

# Your OpenWeatherMap API key (required)
REACT_APP_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: override the API base (defaults to https://api.openweathermap.org/data/2.5)
REACT_APP_WEATHER_API_BASE=https://api.openweathermap.org/data/2.5

# Optional: units for temperature and wind. Allowed: standard, metric, imperial
# - metric: Celsius, m/s
# - imperial: Fahrenheit, mph
# - standard: Kelvin, m/s
REACT_APP_WEATHER_UNITS=metric
