# Vite-style environment variables for the Weather Dashboard
# Copy this file to ".env" and set your values, then restart the dev server.

# Required: Your OpenWeatherMap API key
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: API base URL (defaults to https://api.openweathermap.org/data/2.5)
# VITE_WEATHER_API_BASE=https://api.openweathermap.org/data/2.5

# Optional: Units (standard | metric | imperial). Default: metric
# VITE_WEATHER_UNITS=metric
